{
  "name": "usb-accessory-gadget",
  "author": {
    "email": "diff@protonmail.com",
    "name": "Tim Strazzere"
  },
  "version": "1.0.0",
  "description": "Simple frida gadget for hooking usb accessories and dumping traffic between app and the device.",
  "main": "agent/index.ts",
  "scripts": {
    "prepare": "npm run build",
    "build": "frida-compile agent/index.ts -o _agent.js -c",
    "watch": "frida-compile agent/index.ts -o _agent.js -w",
    "lint": "biome check agent/"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.3",
    "@types/frida-gum": "^19.0.1",
    "@types/node": "^20.19.33",
    "frida-compile": "^19.0.4",
    "frida-java-bridge": "^7.0.12"
  }
}
